{
  "name": "frontend-challenge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node ./scripts/check-line-length.mjs",
    "format": "prettier --write src tests scripts *.config.ts tsconfig.tests.json lighthouse.config.json components.json package.json",
    "format:check": "prettier --check src tests scripts *.config.ts tsconfig.tests.json lighthouse.config.json components.json package.json",
    "preview": "vite preview",
    "audit:lighthouse": "npm run build && node ./scripts/run-lighthouse.mjs",
    "typecheck:test": "tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^28.1.0",
    "lighthouse": "^12.8.2",
    "msw": "^2.10.2",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
